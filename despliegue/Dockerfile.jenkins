# ============================================================================
# DOCKERFILE JENKINS CLOUD (JDK 21 + Maven + Semgrep SAST preinstalado)
# ============================================================================
FROM jenkins/jenkins:lts-jdk21
USER root
RUN apt-get update && \
    apt-get install -y python3-pip git curl && \
    pip3 install --break-system-packages semgrep && \
    printf '#!/bin/bash\nwhile [ $# -gt 0 ]; do\n  if [ "$1" = "semgrep" ]; then\n    shift\n    exec semgrep "$@"\n  fi\n  shift\ndone\nexec /usr/bin/docker "$@"\n' > /usr/local/bin/docker && \
    chmod +x /usr/local/bin/docker && \
    apt-get clean && rm -rf /var/lib/apt/lists/*
USER jenkins
EXPOSE 8080 50000
