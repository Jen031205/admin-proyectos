# ============================================================================
# DOCKERFILE PROMETHEUS + BLACKBOX EXPORTER EN LA NUBE (RAILWAY CLOUD)
# Recolecta TODAS las métricas internas de Spring Boot (/actuator/prometheus)
# de MicroservicioFront y MicroservicioBack (CPU, Memoria JVM, Conexiones BD,
# Todas las rutas HTTP, Latencia, Errores y Logs) + Sondas de Disponibilidad.
# ============================================================================
FROM prom/blackbox-exporter:v0.25.0 AS blackbox

FROM alpine:3.19
RUN apk add --no-cache ca-certificates curl bash prometheus
COPY --from=blackbox /bin/blackbox_exporter /usr/local/bin/blackbox_exporter
COPY monitoreo/prometheus/blackbox.yml /etc/prometheus/blackbox.yml
COPY monitoreo/prometheus/alert.rules.yml /etc/prometheus/alert.rules.yml

RUN printf '#!/bin/bash\n\
set -e\n\
APP_PORT="${PORT:-9090}"\n\
FRONT_TARGET="${FRONTEND_URL:-http://localhost:8080}"\n\
BACK_TARGET="${BACKEND_URL:-https://microservicioback-production.up.railway.app}"\n\
FRONT_CLEAN=$(echo "$FRONT_TARGET" | sed "s:/*$::")\n\
BACK_CLEAN=$(echo "$BACK_TARGET" | sed "s:/*$::")\n\
FRONT_HOST=$(echo "$FRONT_CLEAN" | sed -e "s|^https://||" -e "s|^http://||")\n\
BACK_HOST=$(echo "$BACK_CLEAN" | sed -e "s|^https://||" -e "s|^http://||")\n\
\n\
cat <<EOF > /etc/prometheus/prometheus.yml\n\
global:\n\
  scrape_interval: 10s\n\
  evaluation_interval: 10s\n\
\n\
rule_files:\n\
  - "/etc/prometheus/alert.rules.yml"\n\
\n\
scrape_configs:\n\
  - job_name: "prometheus-server"\n\
    static_configs:\n\
      - targets: ["localhost:${APP_PORT}"]\n\
\n\
  # Recolecta TODAS las métricas internas JVM, CPU, RAM, Tráfico HTTP, Logs y Errores del Backend\n\
  - job_name: "MicroservicioBack-JVM-Actuator"\n\
    metrics_path: "/actuator/prometheus"\n\
    scheme: "https"\n\
    static_configs:\n\
      - targets: ["${BACK_HOST}"]\n\
\n\
  # Recolecta TODAS las métricas internas JVM, CPU, RAM, Tráfico HTTP, Logs y Errores del Frontend\n\
  - job_name: "MicroservicioFront-JVM-Actuator"\n\
    metrics_path: "/actuator/prometheus"\n\
    scheme: "https"\n\
    static_configs:\n\
      - targets: ["${FRONT_HOST}"]\n\
\n\
  # Sondas externas de disponibilidad y tiempo de respuesta sobre todos los módulos\n\
  - job_name: "microservicios-http-probes"\n\
    metrics_path: /probe\n\
    params:\n\
      module: [http_2xx]\n\
    static_configs:\n\
      - targets:\n\
          - ${FRONT_CLEAN}/\n\
          - ${BACK_CLEAN}/buscarUsuario?id=196\n\
          - ${BACK_CLEAN}/buscarProyecto?id_proyecto=197\n\
          - ${BACK_CLEAN}/buscarTarea?id_tarea=199\n\
          - ${BACK_CLEAN}/buscarComentario?id=201\n\
          - ${BACK_CLEAN}/buscarAsignacion?id=1\n\
    relabel_configs:\n\
      - source_labels: [__address__]\n\
        target_label: __param_target\n\
      - source_labels: [__param_target]\n\
        target_label: instance\n\
      - target_label: __address__\n\
        replacement: 127.0.0.1:9115\n\
EOF\n\
\n\
/usr/local/bin/blackbox_exporter --config.file=/etc/prometheus/blackbox.yml --web.listen-address="127.0.0.1:9115" &\n\
exec prometheus \\\n\
  --config.file=/etc/prometheus/prometheus.yml \\\n\
  --storage.tsdb.path=/prometheus \\\n\
  --web.listen-address="0.0.0.0:${APP_PORT}"\n' > /entrypoint.sh && chmod +x /entrypoint.sh

EXPOSE 9090
ENTRYPOINT ["/entrypoint.sh"]
