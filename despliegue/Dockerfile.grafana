# ============================================================================
# DOCKERFILE GRAFANA EN LA NUBE (RAILWAY CLOUD)
# Incluye el Datasource de Prometheus Cloud y el Dashboard preconfigurado:
# "Circuito DevOps - Monitoreo y Observabilidad (admin-proyectos)"
# ============================================================================
FROM grafana/grafana:10.4.1
USER root

COPY monitoreo/grafana/provisioning/dashboards/dashboard.yml /etc/grafana/provisioning/dashboards/dashboard.yml
COPY monitoreo/grafana/dashboards/circuito-devops-dashboard.json /var/lib/grafana/dashboards/circuito-devops-dashboard.json

RUN printf '#!/bin/sh\n\
set -e\n\
export GF_SERVER_HTTP_PORT="${PORT:-3000}"\n\
export GF_SECURITY_ADMIN_USER="${GRAFANA_ADMIN_USER:-admin}"\n\
export GF_SECURITY_ADMIN_PASSWORD="${GRAFANA_ADMIN_PASSWORD:-admin123}"\n\
export GF_USERS_ALLOW_SIGN_UP="false"\n\
PROM_URL="${PROMETHEUS_URL:-http://localhost:9090}"\n\
PROM_CLEAN=$(echo "$PROM_URL" | sed "s:/*$::")\n\
\n\
mkdir -p /etc/grafana/provisioning/datasources\n\
cat <<EOF > /etc/grafana/provisioning/datasources/datasource.yml\n\
apiVersion: 1\n\
datasources:\n\
  - name: Prometheus\n\
    type: prometheus\n\
    access: proxy\n\
    uid: prometheus_devops\n\
    url: ${PROM_CLEAN}\n\
    isDefault: true\n\
    editable: true\n\
EOF\n\
\n\
exec /run.sh\n' > /entrypoint-grafana.sh && chmod +x /entrypoint-grafana.sh

EXPOSE 3000
ENTRYPOINT ["/entrypoint-grafana.sh"]
