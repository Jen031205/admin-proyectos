{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "1. Disponibilidad en Tiempo Real (Frontend, Backend, Actuator y Endpoints)",
      "type": "stat",
      "gridPos": { "h": 5, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus_devops" },
      "targets": [
        { "expr": "up", "legendFormat": "{{job}}", "refId": "A" },
        { "expr": "probe_success", "legendFormat": "{{instance}}", "refId": "B" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "DOWN", "color": "red" },
                "1": { "text": "UP", "color": "green" }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "2. Uso de CPU (%) - MicroservicioFront, MicroservicioBack y Monitoreo",
      "type": "timeseries",
      "gridPos": { "h": 5, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus_devops" },
      "targets": [
        { "expr": "process_cpu_usage * 100", "legendFormat": "CPU JVM (%) - {{job}}", "refId": "A" },
        { "expr": "system_cpu_usage * 100", "legendFormat": "CPU Sistema (%) - {{job}}", "refId": "B" },
        { "expr": "rate(process_cpu_seconds_total[1m]) * 100", "legendFormat": "CPU Proceso (%) - {{job}}", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent" } }
    },
    {
      "id": 3,
      "title": "3. Memoria RAM Utilizada (MB) - JVM Heap y Memoria Residente",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus_devops" },
      "targets": [
        { "expr": "sum by (job) (jvm_memory_used_bytes) / (1024 * 1024)", "legendFormat": "JVM Memoria Usada (MB) - {{job}}", "refId": "A" },
        { "expr": "process_resident_memory_bytes / (1024 * 1024)", "legendFormat": "RAM Residente (MB) - {{job}}", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "decmbytes" } }
    },
    {
      "id": 4,
      "title": "4. Latencia y Tiempo de Respuesta HTTP (Segundos) en Todas las Rutas",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus_devops" },
      "targets": [
        { "expr": "probe_duration_seconds", "legendFormat": "Sonda: {{instance}}", "refId": "A" },
        { "expr": "http_server_requests_seconds_max", "legendFormat": "{{job}} [{{method}} {{uri}} status={{status}}]", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 5,
      "title": "5. Tráfico Total de Peticiones HTTP y Errores por Ruta y Código de Estado",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus_devops" },
      "targets": [
        { "expr": "http_server_requests_seconds_count", "legendFormat": "{{job}}: {{method}} {{uri}} (HTTP {{status}})", "refId": "A" },
        { "expr": "probe_http_status_code", "legendFormat": "Código HTTP Sonda: {{instance}}", "refId": "B" }
      ]
    },
    {
      "id": 6,
      "title": "6. Registros (Logs INFO / WARN / ERROR) y Conexiones Activas a Base de Datos MySQL",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus_devops" },
      "targets": [
        { "expr": "logback_events_total", "legendFormat": "Logs [{{level}}] - {{job}}", "refId": "A" },
        { "expr": "hikaricp_connections_active", "legendFormat": "Conexiones Activas MySQL - {{job}}", "refId": "B" },
        { "expr": "hikaricp_connections", "legendFormat": "Pool Total Conexiones MySQL - {{job}}", "refId": "C" }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["devops", "admin-proyectos", "monitoreo"],
  "templating": { "list": [] },
  "time": { "from": "now-15m", "to": "now" },
  "title": "Circuito DevOps - Monitoreo y Observabilidad (admin-proyectos)",
  "uid": "circuito-devops-admin-proyectos",
  "version": 2
}
