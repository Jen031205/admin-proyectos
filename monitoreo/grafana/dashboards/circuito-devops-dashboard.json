{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Disponibilidad de Endpoints (Frontend, Backend REST y MariaDB)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus_devops" },
      "targets": [
        {
          "expr": "probe_success",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "DOWN", "color": "red" },
                "1": { "text": "UP", "color": "green" }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Códigos de Respuesta HTTP por Endpoint",
      "type": "stat",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus_devops" },
      "targets": [
        {
          "expr": "probe_http_status_code",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Latencia de Respuesta HTTP (Segundos) - Frontend y Backend",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus_devops" },
      "targets": [
        {
          "expr": "probe_duration_seconds{job=\"microservicios-http-probes\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "id": 4,
      "title": "Consumo de Memoria RAM y CPU del Nodo de Monitoreo",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus_devops" },
      "targets": [
        {
          "expr": "process_resident_memory_bytes / (1024 * 1024)",
          "legendFormat": "Memoria Residente (MB) - {{job}}",
          "refId": "A"
        },
        {
          "expr": "rate(process_cpu_seconds_total[1m]) * 100",
          "legendFormat": "Uso CPU (%) - {{job}}",
          "refId": "B"
        }
      ]
    }
  ],
  "refresh": "10s",
